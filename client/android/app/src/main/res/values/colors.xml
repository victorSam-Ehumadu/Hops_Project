<?xml version="1.0" encoding="utf-8"?>
<!--
    Colours for the native launch screen only (drawable/launch_background.xml).
    This is the window the OS paints before Flutter exists, so nothing in
    lib/ can influence it — it has to be resolved from resource qualifiers.

    Light-mode values live here; values-night/colors.xml holds the dark ones
    and Android picks between them by the system dark-mode setting.
-->
<resources>
    <!-- Matches Theme.Light's colorBackground, which is what LaunchTheme
         inherited before this file existed. -->
    <color name="splash_background">#FFFFFFFF</color>

    <!--
        Adaptive launcher icon background (mipmap-anydpi-v26/ic_launcher.xml).
        White, because that is exactly what Android was already compositing
        behind the legacy icon — this keeps the icon looking the same while
        letting the launcher mask it properly. Change this one value to put
        the bunny on a brand colour instead.

        Deliberately NOT given a values-night/ variant: a launcher icon that
        changes colour with dark mode is disorienting on a home screen.
    -->
    <color name="ic_launcher_background">#FFFFFFFF</color>
</resources>
